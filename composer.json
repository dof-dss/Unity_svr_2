{
    "name": "dof-dss/maestro-drupal-unity",
    "description": "Maestro Drupal for Unity sites",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "support": {
        "docs": "https://digitaldevelopment.atlassian.net/wiki/spaces/MAES"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "kenwheeler/slick",
                "version": "1.8.0",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/kenwheeler/slick/archive/1.8.0.zip",
                    "type": "zip"
                },
                "require": {
                    "composer/installers": "^2.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "dinbror/blazy",
                "version": "1.8.2",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/dinbror/blazy/archive/1.8.2.zip",
                    "type": "zip"
                },
                "require": {
                    "composer/installers": "^1.2.0"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "accessible360/accessible-slick",
                "version": "1.0.1",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/Accessible360/accessible-slick/archive/refs/tags/v1.0.1.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "*",
        "accessible360/accessible-slick": "^1.0",
        "aws/aws-sdk-php": "^3.369",
        "caxy/php-htmldiff": "^0.1.15",
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "dof-dss/nicsdru_origins_modules": "^11.0",
        "dof-dss/nicsdru_unity_modules": "^11.1",
        "dof-dss/nicsdru_unity_profile": "^11",
        "dof-dss/nicsdru_unity_theme": "^11",
        "drupal/address": "^2.0",
        "drupal/admin_toolbar": "^3.6",
        "drupal/allowed_formats": "^3.0",
        "drupal/antibot": "^2.0",
        "drupal/auto_entityqueue": "^3.0",
        "drupal/blazy": "^3.0",
        "drupal/block_field": "^1.0@RC",
        "drupal/block_list_override": "^1.0",
        "drupal/block_visibility_groups": "^2.0",
        "drupal/ckeditor5_allowed_html": "^1.5@dev",
        "drupal/ckeditor5_premium_features": "^1.6",
        "drupal/ckeditor_lts": "^1.0",
        "drupal/clientside_validation": "^4.0",
        "drupal/config_filter": "^1.10",
        "drupal/config_ignore": "^3.2",
        "drupal/config_readonly": "^1.0@beta",
        "drupal/config_split": "^2.0",
        "drupal/config_update": "^2.0@alpha",
        "drupal/content_lock": "^3.0",
        "drupal/cookie_content_blocker": "^2.6",
        "drupal/core-composer-scaffold": "^11.3",
        "drupal/core-project-message": "^11.3",
        "drupal/core-recommended": "^11.3",
        "drupal/csp": "^1.20",
        "drupal/ctools": "^4.1",
        "drupal/date_facet_drilldown": "^12.0@dev",
        "drupal/draggableviews": "^2.1",
        "drupal/dynamic_entity_reference": "^3.2",
        "drupal/entity_browser": "^2.16",
        "drupal/entity_embed": "^1.4",
        "drupal/entity_reference_revisions": "^1.14",
        "drupal/entityqueue": "^1.6",
        "drupal/facets": "2.0.10",
        "drupal/facets_pretty_paths": "^2.0",
        "drupal/fastly": "^4.0",
        "drupal/field_group": "^3.4",
        "drupal/flag": "^4.0@beta",
        "drupal/flood_control": "^3.0",
        "drupal/geocoder": "^4.9",
        "drupal/geolocation": "^3.12",
        "drupal/google_tag": "^2.0",
        "drupal/handy_cache_tags": "^1.4",
        "drupal/honeypot": "^2.2",
        "drupal/http_cache_control": "^2.8",
        "drupal/inline_entity_form": "^3.0@RC",
        "drupal/jquery_ui_accordion": "^2.0",
        "drupal/layout_builder_modal": "^1.2",
        "drupal/layout_builder_restrictions": "^3.0",
        "drupal/link_field_autocomplete_filter": "^2.0",
        "drupal/link_fix_absolute_urls": "^1.0",
        "drupal/linkit": "^7.0",
        "drupal/media_entity_browser": "^3.0",
        "drupal/media_file_delete": "^1.3",
        "drupal/media_library_edit": "^3.0",
        "drupal/menu_admin_per_menu": "^1.7",
        "drupal/menu_breadcrumb": "^2.0",
        "drupal/metatag": "^2.2",
        "drupal/migrate_upgrade": "^4.0",
        "drupal/moderation_sidebar": "^1.7",
        "drupal/node_edit_protection": "^1.1",
        "drupal/noreferrer": "^1.16",
        "drupal/oembed_providers": "^2.1",
        "drupal/paragraphs": "^1.20",
        "drupal/pathauto": "^1.14",
        "drupal/rdf": "^4.0",
        "drupal/read_only_mode": "^1.0@dev",
        "drupal/readonlymode": "1.3",
        "drupal/redirect": "1.13",
        "drupal/redis": "^1.7",
        "drupal/scheduled_transitions": "^2.7",
        "drupal/scheduler": "^2.0",
        "drupal/scheduler_content_moderation_integration": "^3.0",
        "drupal/schema_metatag": "^3.0",
        "drupal/search_api": "^1.41",
        "drupal/search_api_autocomplete": "^1.4",
        "drupal/search_api_glossary": "^4.2",
        "drupal/search_api_location": "^1.0@alpha",
        "drupal/search_api_solr": "^4.3",
        "drupal/search_api_spellcheck": "^4.0",
        "drupal/shs": "^2.0@RC",
        "drupal/simplei": "^3.0",
        "drupal/sitemap": "^2.0",
        "drupal/slick": "^3.0",
        "drupal/slick_views": "^3.0",
        "drupal/smart_date": "^4.3",
        "drupal/stable": "^2.0",
        "drupal/structure_sync": "^2.0",
        "drupal/taxonomy_access_fix": "^4.0",
        "drupal/taxonomy_manager": "^2.0",
        "drupal/telephone_plus": "^2.0",
        "drupal/token": "^1.17",
        "drupal/token_filter": "^2.2",
        "drupal/twig_field_value": "^2.0",
        "drupal/twig_tweak": "^3.4",
        "drupal/ultimate_cron": "^2.0@alpha",
        "drupal/views_contextual_filters_or": "^1.4",
        "drupal/views_custom_cache_tag": "^1.3",
        "drupal/webform": "^6.3",
        "drupal/whatlinkshere": "^2.1",
        "drush/drush": "^13.0",
        "ezyang/htmlpurifier": "^4.17",
        "geocoder-php/google-maps-provider": "^4.7",
        "harvesthq/chosen": "^1.8",
        "kenwheeler/slick": "^1.8",
        "oomphinc/composer-installers-extender": "^2.0",
        "php-http/message-factory": "^1.1",
        "platformsh/config-reader": "^2.4",
        "symfony/http-client": "^7.4",
        "vlucas/phpdotenv": "^5.5"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "sort-packages": true
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/clientside_validation": {
                "core/jquery.once is required": "https://www.drupal.org/files/issues/2021-02-23/3200022-01.patch"
            },
            "drupal/config_split": {
                "Config export fails": "https://www.drupal.org/files/issues/2025-09-01/config_split-3511132-3.patch"
            },
            "drupal/core": {
                "Render blocks in preview page": "https://www.drupal.org/files/issues/2019-10-03/3085364_2.patch",
                "User enable email exception": "https://www.drupal.org/files/issues/2023-05-19/user_email_exception-3355151-3.patch",
                "Fix getSetting() error on translated migrations": "https://www.drupal.org/files/issues/2018-07-08/2984460-3.patch",
                "Fix to $form.ajaxSubmit is not a function": "https://git.drupalcode.org/project/drupal/-/merge_requests/6052.diff",
                "DateList and date range inline form errors are repeated": "https://www.drupal.org/files/issues/2020-01-30/2827034-35.patch",
                "Undefined title": "https://www.drupal.org/files/issues/2026-01-08/undefined_title_3566415.patch",
                "Handle configuration collections added during import #3532738": "https://www.drupal.org/files/issues/2025-06-27/configimporter-multisite-null-safety.patch"
            },
            "drupal/entityqueue": {
                "Allow unique records only": "https://www.drupal.org/files/issues/2026-09-10/entityqueue-disallow-duplicates-3197148-11.patch"
            },
            "drupal/facets": {
                "Pass facet object onto child items": "https://www.drupal.org/files/issues/2019-11-13/child_item-3094143-2.patch"
            },
            "drupal/fastly": {
                "Allow disabling of logging": "https://git.drupalcode.org/project/fastly/-/merge_requests/6.patch"
            },
            "drupal/hms_field": {
                "Drupal 9 compatability": "https://www.drupal.org/files/issues/2020-06-06/hms_field.1.x-dev.rector.patch"
            },
            "drupal/linkit": {
                "Show URL alias after autocomplete selection instead of internal route (e.g., /node/123)": "https://www.drupal.org/files/issues/2026-07-09/linkit-2877535-104.patch"
            },
            "drupal/media_browser_responsive_images": {
                "Form alter applies for any media browser, not just image related ones": "https://www.drupal.org/files/issues/2019-12-17/media-browser-hook-checks-for-image-types.patch"
            },
            "drupal/smart_date": {
                "Hide duration field": "https://www.drupal.org/files/issues/2024-10-07/3379263-duration-fix.patch"
            },
            "drupal/ultimate_cron": {
                "Fix $last_ran deprecation error": "https://www.drupal.org/files/issues/2023-04-03/3351276-4.patch"
            },
            "drupal/readonlymode": {
                "Fatal typerror fix": "https://www.drupal.org/files/issues/2020-12-23/readonlymode-string_not_array-3115119-9.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "harvesthq/chosen"
            ],
            "web/modules/origins": [
                "dof-dss/nicsdru_origins_modules"
            ],
            "web/modules/custom": [
                "dof-dss/nicsdru_unity_modules"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/unity/nicsdru_unity_profile": [
                "dof-dss/nicsdru_unity_profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "web/profiles/origins/{$name}": [
                "dof-dss/nicsdru_origins_profile"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    },
    "require-dev": {
        "dof-dss/maestro-hosting": "^1.0",
        "dof-dss/maestro-shell": "^11.0.1",
        "drupal/coder": "^8.3",
        "drupal/core-dev": "^11.3",
        "drupal/devel": "^5.4",
        "drupal/diff": "^2.1",
        "drupal/eu_cookie_compliance": "^1.29",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.1",
        "drupal/stage_file_proxy": "^3.1",
        "drupal/kint": "^2.3",
        "mglaman/drupal-check": "^1.4",
        "phpstan/extension-installer": "^1.3",
        "slevomat/coding-standard": "^8.13",
        "spaze/phpstan-disallowed-calls": "^3.1"
    },
    "scripts": {
        "post-package-update": [
            "Maestro\\Shell\\Events\\ComposerEventListener::postPackageUpdate"
        ]
    }
}
